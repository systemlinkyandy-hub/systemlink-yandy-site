<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IAC Chat" Height="640" Width="520" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="MessageBubbleTemplate">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6" Background="#F7F7F7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding DateText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TaskId}" Foreground="Gray" FontSize="10" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding WarningText}" Foreground="#B36B00" FontSize="10" Margin="0,4,0,0"
                               Visibility="{Binding WarningVisibility}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="コピー→入力欄へ" Tag="{Binding}" Padding="6,2" Margin="0,0,4,0" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: メッセージ一覧 -->
        <ScrollViewer Grid.Row="0" Name="MessageScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl Name="MessageList" ItemTemplate="{StaticResource MessageBubbleTemplate}"/>
        </ScrollViewer>

        <!-- Row 1: 同期ステータス -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="SyncStatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Text="未同期"/>
            <Button Name="ResyncButton" Grid.Column="1" Content="今すぐ同期" Padding="6,2" FontSize="11"/>
        </Grid>

        <!-- Row 2: Push失敗バナー（初期は非表示） -->
        <Border Grid.Row="2" Name="FailureBanner" Background="#FFE0E0" BorderBrush="#CC6666" BorderThickness="1"
                CornerRadius="4" Padding="6" Margin="0,0,0,4" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="FailureBannerText" Grid.Column="0" TextWrapping="Wrap" FontSize="11" Foreground="#993333"
                           Text="配送失敗。ローカルcommitは保持されています。"/>
                <Button Name="RetryButton" Grid.Column="1" Content="再送信" Padding="6,2" FontSize="11" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Row 3: 入力エリア -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <ComboBox Name="ToCombo" Width="220" Margin="0,0,8,0"/>
                <Button Name="WakeButton" Content="wake" Margin="0,0,4,0" Padding="8,2"/>
                <Button Name="ChatButton" Content="chat" Padding="8,2"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="InputBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="64" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                <Button Name="SendButton" Grid.Column="1" Content="送信" Width="64" VerticalAlignment="Bottom"/>
            </Grid>

            <TextBlock Grid.Row="2" Name="CharCountText" HorizontalAlignment="Right" FontSize="10" Foreground="Gray" Margin="0,2,0,0" Text="0 / 300"/>
        </Grid>
    </Grid>
</Window>
